# Copy this file to a new file named exactly ".env" (note the dot at the start)
# and replace the text after the = sign with your own key.
# Get a key at https://console.anthropic.com  ->  API Keys.
# No spaces, no quotes.
ANTHROPIC_API_KEY=your_api_key_here

# ---- Optional settings (remove the # at the start of a line to use it) ----

# Claude model used to write the script (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Let the API retry on another model if a safety filter wrongly declines the text.
# Set to off if you get an error mentioning "fallbacks". Default: on
# CLAUDE_FALLBACKS=on

# Voice: tr-TR-AhmetNeural (male, default) or tr-TR-EmelNeural (female)
# TTS_VOICE=tr-TR-AhmetNeural
# Speaking speed in percent (-10 = 10% slower) and pitch in Hz (-5 = deeper)
# TTS_RATE=0
# TTS_PITCH=0

# Full path to a bold .ttf font for the subtitles (default: automatic)
# SUBTITLE_FONT=C:\Windows\Fonts\arialbd.ttf
